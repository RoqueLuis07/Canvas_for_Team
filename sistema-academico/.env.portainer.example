# Variables que interpola docker-compose.yml (stack de Portainer, Avance 2).
# No es el .env de Laravel (ver .env.example) — estas son las que hay que
# cargar en Portainer: Stacks → (tu stack) → Environment variables, o en un
# archivo ".env" junto a docker-compose.yml si se despliega con
# `docker compose up -d` por línea de comandos.

# Generar una vez con: php artisan key:generate --show
# Fijarla acá y NO dejar que el contenedor la regenere en cada reinicio
# (si cambia, se invalidan las sesiones y las cookies encriptadas).
APP_KEY=

# Credenciales de la base MySQL del stack (elegir una contraseña propia,
# no reutilizar la de otro entorno).
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Mismas credenciales que el sistema FastAPI (Canvas_for_Teams) — se puede
# dejar todo esto vacío para desplegar sin integración real: el sistema cae
# automáticamente a clientes simulados (ver AppServiceProvider) y el resto
# de la plataforma funciona igual.
CANVAS_BASE_URL=https://usilparaguay.instructure.com
CANVAS_ACCESS_TOKEN=
CANVAS_ACCOUNT_ID=1

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
